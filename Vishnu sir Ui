import React, { useState } from "react";

const approvalConditions = {
  "LATEST PASSPORT": "Ensure both front and back are uploaded in PDF format and passport is valid for at least 6 months.",
  "CREW ID CARD": "Front and back must be clearly visible in PDF format. Must match crew details.",
  "TRANSFER LETTER": "Only applicable if crew has changed base or department. Must be signed by HR.",
  "INITIAL CREW CONTRACT": "Must be signed and dated. Verify joining date and role.",
  "RENEWAL CREW CONTRACT": "Check for updated terms and renewal period. Must be signed.",
  "PROMOTION LETTER": "Applicable only if crew has been promoted. Must be signed by authorized personnel.",
  "PHOTOGRAPH PASSPORT SIZE": "Should be clear with white or blue background. No shadows or filters.",
  "EDUCATION CERTIFICATE": "Verify certificates from 10th to Graduation. Must be legible and authentic.",
  "AAHAR CARD": "Ensure full name and address are visible. Must be in PDF format.",
  "PAN CARD": "Verify PAN number and name. Must be clear and match crew records.",
};

const documentTypes = Object.keys(approvalConditions);
const samplePdf = "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf";

type DocumentStatus = "Pending" | "Approved" | "Rejected";
interface CrewDocument {
  id: number;
  igacode: string;
  crewName: string;
  base: string;
  documentType: string;
  status: DocumentStatus;
  uploadDate: string;
  pdfUrl?: string;
  passportNumber?: string;
  expiryDate?: string;
  department?: string;
}

const mockData: CrewDocument[] = Array.from({ length: 20 }, (_, i) => ({
  id: i + 1,
  igacode: `IGA-${1000 + i}`,
  crewName: `Crew Member ${i % 5 + 1}`,
  base: ["Delhi", "Mumbai", "Goa", "Chennai", "Kolkata"][i % 5],
  documentType: documentTypes[i % documentTypes.length],
  status: "Pending",
  uploadDate: `2025-09-${(i % 30) + 1}`,
  pdfUrl: samplePdf,
  passportNumber: `A1234${i}`,
  expiryDate: `202${(i % 5) + 6}-12-31`,
  department: ["Deck", "Engine", "Catering", "Hotel", "Medical"][i % 5],
}));

const statusMeta = {
  Pending: {
    icon: (
      <svg className="w-5 h-5 text-yellow-500 inline" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
        <path d="M12 2L2 22h20L12 2z" fill="#facc15" />
        <text x="9" y="17" fill="#fff" fontSize="10" fontFamily="Arial">!</text>
      </svg>
    ),
    label: "Pending",
    color: "text-yellow-600 bg-yellow-50",
  },
  Approved: {
    icon: (
      <svg className="w-5 h-5 text-green-500 inline" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" fill="#22c55e" />
        <polyline points="9 12 12 15 16 10" fill="none" stroke="#fff" strokeWidth="2"/>
      </svg>
    ),
    label: "Approved",
    color: "text-green-600 bg-green-50",
  },
  Rejected: {
    icon: (
      <svg className="w-5 h-5 text-red-500 inline" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" fill="#ef4444"/>
        <line x1="9" y1="9" x2="15" y2="15" stroke="#fff" strokeWidth="2"/>
        <line x1="15" y1="9" x2="9" y2="15" stroke="#fff" strokeWidth="2"/>
      </svg>
    ),
    label: "Rejected",
    color: "text-red-600 bg-red-50",
  },
};

const CrewDocuments: React.FC = () => {
  const [docs, setDocs] = useState<CrewDocument[]>(mockData);
  const [previewDoc, setPreviewDoc] = useState<CrewDocument | null>(null);

  // Stats
  const pendingDocs = docs.filter(doc => doc.status === "Pending").length;
  const approvedDocs = mockData.length - docs.length; // approved ones removed

  // Approve action → remove from table
  function handleDecision(docId: number, status: "Approved" | "Rejected") {
    if (status === "Approved") {
      setDocs(prev => prev.filter(d => d.id !== docId));
    } else {
      setDocs(prev => prev.map(d => d.id === docId ? { ...d, status } : d));
    }
  }

  return (
    <div className="min-h-screen bg-gradient-to-tr from-blue-50 to-white p-6">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:justify-between items-start md:items-center mb-6 gap-3">
        <div>
          <h1 className="text-3xl font-extrabold text-[#000099]">Crew Documents</h1>
          <p className="text-gray-500">Manage and review all crew documents</p>
        </div>
        <div className="flex gap-3">
          {/* Pending */}
          <div className="flex items-center bg-yellow-50 px-4 py-2 rounded shadow gap-2 border border-yellow-200 min-w-[130px]">
            {statusMeta.Pending.icon}
            <span className="font-bold text-yellow-700">{pendingDocs}</span>
            <span className="text-xs text-yellow-600">Pending</span>
          </div>
          {/* Approved */}
          <div className="flex items-center bg-green-50 px-4 py-2 rounded shadow gap-2 border border-green-200 min-w-[130px]">
            {statusMeta.Approved.icon}
            <span className="font-bold text-green-700">{approvedDocs}</span>
            <span className="text-xs text-green-600">Approved</span>
          </div>
        </div>
      </div>

      {/* Table */}
      <div className="overflow-x-auto bg-white shadow rounded-lg border border-blue-100">
        <table className="w-full text-sm text-left text-gray-700">
          <thead className="bg-blue-50 text-blue-900 font-semibold">
            <tr>
              <th className="px-4 py-3">IGA Code</th>
              <th className="px-4 py-3">Name</th>
              <th className="px-4 py-3">Base</th>
              <th className="px-4 py-3">Upload Date</th>
              <th className="px-4 py-3">Document Type</th>
              <th className="px-4 py-3">Status</th>
              <th className="px-4 py-3">Action</th>
            </tr>
          </thead>
          <tbody>
            {docs.length === 0 && (
              <tr>
                <td colSpan={7} className="text-center py-6 text-gray-400">
                  All documents are approved 🎉
                </td>
              </tr>
            )}
            {docs.map(doc => (
              <tr key={doc.id} className="border-t hover:bg-blue-50 transition">
                <td className="px-4 py-3">{doc.igacode}</td>
                <td className="px-4 py-3">{doc.crewName}</td>
                <td className="px-4 py-3">{doc.base}</td>
                <td className="px-4 py-3">{doc.uploadDate}</td>
                <td className="px-4 py-3">{doc.documentType}</td>
                <td className="px-4 py-3">
                  <span className={`px-2 py-1 rounded text-xs font-semibold ${statusMeta[doc.status].color} flex gap-1 items-center w-fit`}>
                    {statusMeta[doc.status].icon} {statusMeta[doc.status].label}
                  </span>
                </td>
                <td className="px-4 py-3">
                  <button
                    className="px-3 py-1 rounded bg-gradient-to-r from-blue-100 to-blue-300 text-blue-800 font-bold text-xs shadow hover:bg-blue-200"
                    onClick={() => setPreviewDoc(doc)}
                  >
                    Take Action
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Preview / Action Modal */}
      {previewDoc && (
        <div className="fixed inset-0 z-50 bg-black bg-opacity-40 flex items-center justify-center px-2 py-6">
          <div className="bg-white rounded-lg max-w-3xl w-full p-6 shadow-lg relative flex flex-col md:flex-row gap-4">
            {/* Close */}
            <button onClick={() => setPreviewDoc(null)} className="absolute top-2 right-2 text-gray-400 hover:text-red-600">
              <svg className="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth={2}>
                <line x1="6" y1="18" x2="18" y2="6"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
            {/* PDF */}
            <div className="flex-1 border rounded bg-gray-100 flex justify-center items-center min-h-[300px]">
              <iframe src={previewDoc.pdfUrl} title="PDF Preview" className="w-full h-80 rounded border shadow" />
            </div>
            {/* Details + Actions */}
            <div className="flex-1 min-w-[200px]">
              <div className="font-semibold text-blue-900 mb-1">{previewDoc.documentType}</div>
              <div className="mb-2 text-xs text-gray-500">{previewDoc.uploadDate}</div>
              <div className="mb-2 text-xs">Name: <span className="font-medium">{previewDoc.crewName}</span></div>
              <div className="mb-2 text-xs">IGA Code: {previewDoc.igacode}</div>
              <div className="mb-2 text-xs">Base: {previewDoc.base}</div>
              <div className="mb-2 text-xs">Dept: {previewDoc.department}</div>
              <div className={`mt-2 text-xs font-bold ${statusMeta[previewDoc.status].color}`}>Status: {statusMeta[previewDoc.status].label}</div>

              {previewDoc.status === "Pending" && (
                <div className="mt-4 flex gap-2">
                  <button
                    className="px-3 py-1 rounded bg-green-100 text-green-700 font-bold text-xs hover:bg-green-200"
                    onClick={() => { handleDecision(previewDoc.id, "Approved"); setPreviewDoc(null); }}
                  >
                    Approve
                  </button>
                  <button
                    className="px-3 py-1 rounded bg-red-100 text-red-700 font-bold text-xs hover:bg-red-200"
                    onClick={() => { handleDecision(previewDoc.id, "Rejected"); setPreviewDoc(null); }}
                  >
                    Reject
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default CrewDocuments;
