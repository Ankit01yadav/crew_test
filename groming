                  <th className="px-6 py-3 text-left text-xs text-aviation-muted uppercase tracking-wider">Date</th>
                   <th className="px-6 py-3 text-left text-xs text-aviation-muted uppercase tracking-wider">IGA-Code</th>
                  <th className="px-6 py-3 text-left text-xs text-aviation-muted uppercase tracking-wider">Name</th>
                   <th className="px-6 py-3 text-left text-xs text-aviation-muted uppercase tracking-wider">Status</th>
                   <th className="px-6 py-3 text-left text-xs text-aviation-muted uppercase tracking-wider">Actions</th>
                 </tr>
               </thead>
               <tbody className="divide-y divide-border">
                 {allGrooomingdata.map((report) => (
                   <tr key={report.iga} className="hover:bg-aviation-surface transition-colors">
                    <td className="px-6 py-4">
                     {new Date(report.takenAt).toLocaleDateString('en-GB')}
                    </td>
                     <td className="px-6 py-4 font-mono text-sm">{report.crewId}</td>
                     <td className="px-6 py-4">{report.crewName}</td>
                     

                     <td className="px-6 py-4">
                       <span className={getApprovalColor(report.status)}>
                         {report.status }
                       </span>
                     </td>
                     <td className="px-6 py-4">
                       <div className="flex space-x-2">
                         {role === "Admin" && (
                           <>
                             <button className="p-1 rounded-md hover:bg-blue-200 transition">
                               <Pencil className="h-4 w-4 text-blue-700" />
                             </button>
                             <button className="p-1 rounded-md hover:bg-red-200 transition">
                               <Trash className="h-4 w-4 text-red-700" />
                             </button>
                           </>
                         )}
                         <button className="p-1 rounded-md hover:bg-blue-200 transition">
                           <Eye className="h-4 w-4 text-blue-700" />
                         </button>
                         <button className="p-1 rounded-md hover:bg-blue-200 transition">
                           <Download className="h-4 w-4 text-blue-700" />
                         </button>
                       </div>
                     </td>
   
                   </tr>
   
                 ))}
               </tbody>
             </table>
           </div>
          
       </div>
  </div>
  );
};
export default Grooming;



