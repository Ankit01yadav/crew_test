  const filterReportsByView = (): Grooming[] => {
    const now = new Date();
    let filtered = [...allReports];

    if (viewFilter === "lastWeek") {
      const weekAgo = new Date(now);
      weekAgo.setDate(weekAgo.getDate() - 7);
      filtered = filtered.filter(r => new Date(r.date) >= weekAgo);
    } else if (viewFilter === "lastMonth") {
      const monthAgo = new Date(now);
      monthAgo.setMonth(monthAgo.getMonth() - 1);
      filtered = filtered.filter(r => new Date(r.date) >= monthAgo);
    } else if (viewFilter === "last30") {
      const ninetyAgo = new Date(now);
      ninetyAgo.setDate(ninetyAgo.getDate() - 90);
      filtered = filtered.filter(r => new Date(r.date) >= ninetyAgo);
    } else if (viewFilter === "custom" && startDate && endDate) {
      const diff = (endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24);
      if (diff <= 90) {
        filtered = filtered.filter(r => {
          const d = new Date(r.date);
          return d >= startDate && d <= endDate;
        });
      }
    }


    return filtered;
  };
  


