import React, { useState, useEffect } from "react";

// approvalConditions, mockData, statusMeta definitions as before

const URGENT_THRESHOLD = 50;

function sendUrgentNotification(count) {
  if ('Notification' in window) {
    if (Notification.permission === 'granted') {
      new Notification('Urgent Approval Needed', { body: `You have ${count} pending documents.` });
    } else if (Notification.permission !== 'denied') {
      Notification.requestPermission().then(perm => {
        if (perm === 'granted') {
          new Notification('Urgent Approval Needed', { body: `You have ${count} pending documents.` });
        }
      });
    }
  }
}

const CrewDocuments = () => {
  const [docs, setDocs] = useState(mockData);
  const [expanded, setExpanded] = useState(null);
  const [search, setSearch] = useState("");
  const [selectedDocIds, setSelectedDocIds] = useState([]);
  const [showPreviewDoc, setShowPreviewDoc] = useState(null);

  const crewGroups = docs.reduce((acc, doc) => {
    if (!acc[doc.crewName]) acc[doc.crewName] = [];
    acc[doc.crewName].push(doc);
    return acc;
  }, {});
  const crewNames = Object.keys(crewGroups).filter(name => name.toLowerCase().includes(search.toLowerCase()));
  const pendingDocs = docs.filter(doc => doc.status === "Pending");
  const urgent = pendingDocs.length >= URGENT_THRESHOLD;

  useEffect(() => {
    if (urgent) sendUrgentNotification(pendingDocs.length);
  }, [urgent, pendingDocs.length]);

  function bulkApproveSelected() {
    setDocs(prev =>
      prev.map(doc => selectedDocIds.includes(doc.id) && doc.status === "Pending"
        ? { ...doc, status: "Approved" }
        : doc
      ));
    setSelectedDocIds([]);
  }

  function handleSelect(docId) {
    setSelectedDocIds(prev =>
      prev.includes(docId) ? prev.filter(id => id !== docId) : [...prev, docId]
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-tr from-blue-50 to-white p-4 md:p-8">
      {urgent && (
        <div className="mb-4 bg-red-100 border-l-4 border-red-600 rounded shadow p-4 flex items-center justify-between animate-pulse">
          <b className="text-red-700 text-xl">
            Urgent: {pendingDocs.length} documents need approval!
          </b>
          <button
            onClick={bulkApproveSelected}
            className="bg-red-600 text-white font-bold px-4 py-2 rounded shadow hover:bg-red-700 transition"
            disabled={selectedDocIds.length === 0}
          >
            Approve Selected ({selectedDocIds.length})
          </button>
        </div>
      )}

      {/* Bulk selection bar and search as before */}
      {selectedDocIds.length > 0 && (
        <div className="mb-4 flex items-center justify-between bg-blue-50 border-l-4 border-blue-400 rounded px-4 py-2 shadow">
          <div>Bulk selected: <span className="font-bold text-blue-800">{selectedDocIds.length}</span></div>
          <button
            onClick={bulkApproveSelected}
            className="bg-green-600 text-white font-bold px-4 py-2 rounded hover:bg-green-700 transition"
          >Approve Selected</button>
        </div>
      )}

      <div className="w-full max-w-xl mx-auto mb-6">
        <input value={search}
          onChange={e => setSearch(e.target.value)}
          className="w-full p-3 rounded-full border focus:ring-2 focus:ring-blue-300 bg-white shadow-sm text-sm"
          placeholder="Search crew by name..."
        />
      </div>

      <div className="space-y-8">
        {crewNames.map((crew) => (
          <div key={crew} className="bg-white rounded-xl shadow border p-4">
            <div className="flex items-center cursor-pointer"
              onClick={() => setExpanded(expanded === crew ? null : crew)}
            >
              <span className="text-lg font-semibold text-blue-900">{crew}</span>
              <span className="ml-auto mr-3 text-gray-400 text-xs">{crewGroups[crew].length} Docs</span>
            </div>
            <div style={{ display: expanded === crew ? "grid" : "none" }} className="mt-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {crewGroups[crew].map(doc => (
                <div key={doc.id} className={`p-4 rounded-lg border shadow-sm
                  ${doc.status === "Pending" && urgent ? "border-red-500 bg-red-50 animate-pulse" : "bg-[#f7fafc]"}`}
                >
                  {doc.status === "Pending" && (
                    <input
                      type="checkbox"
                      checked={selectedDocIds.includes(doc.id)}
                      onChange={() => handleSelect(doc.id)}
                      className="mr-2 accent-blue-500 scale-125"
                    />
                  )}
                  <div className="font-semibold text-blue-800 mb-0.5">{doc.documentType}</div>
                  <div className="text-xs text-gray-500 mb-2">{doc.uploadDate}</div>
                  <button className="mt-2 px-3 py-1 bg-blue-100 rounded" onClick={() => setShowPreviewDoc(doc)}>
                    View Doc
                  </button>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      {showPreviewDoc && (
        <div className="fixed inset-0 z-50 bg-black bg-opacity-40 flex items-center justify-center px-2 py-6">
          <div className="bg-white rounded-lg max-w-2xl w-full p-6 shadow-lg relative">
            <button onClick={() => setShowPreviewDoc(null)} className="absolute top-2 right-2 text-gray-400 hover:text-red-600">
              Close
            </button>
            <iframe src={showPreviewDoc.pdfUrl} title="PDF Preview" className="w-full h-80 rounded border shadow" />
          </div>
        </div>
      )}
    </div>
  );
};

export default CrewDocuments;
