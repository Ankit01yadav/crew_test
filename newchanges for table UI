import React, { useState } from "react";

// Approval requirements for each type
const approvalConditions: Record<string, string> = {
  "LATEST PASSPORT": "Ensure both front and back are uploaded in PDF format and passport is valid for at least 6 months.",
  "CREW ID CARD": "Front and back must be clearly visible in PDF format. Must match crew details.",
  "TRANSFER LETTER": "Only applicable if crew has changed base or department. Must be signed by HR.",
  "INITIAL CREW CONTRACT": "Must be signed and dated. Verify joining date and role.",
  "RENEWAL CREW CONTRACT": "Check for updated terms and renewal period. Must be signed.",
  "PROMOTION LETTER": "Applicable only if crew has been promoted. Must be signed by authorized personnel.",
  "PHOTOGRAPH PASSPORT SIZE": "Should be clear with white or blue background. No shadows or filters.",
  "EDUCATION CERTIFICATE": "Verify certificates from 10th to Graduation. Must be legible and authentic.",
  "AAHAR CARD": "Ensure full name and address are visible. Must be in PDF format.",
  "PAN CARD": "Verify PAN number and name. Must be clear and match crew records.",
};

const documentTypes = Object.keys(approvalConditions);
const samplePdf = "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf";

// Demo doc with extra fields
type DocumentStatus = "Pending" | "Approved" | "Rejected";
interface CrewDocument {
  id: number;
  crewName: string;
  documentType: string;
  status: DocumentStatus;
  uploadDate: string;
  pdfUrl?: string;
  name?: string;
  passportNumber?: string;
  expiryDate?: string;
  department?: string;
}

// Sample mock data
const mockData: CrewDocument[] = Array.from({ length: 20 }, (_, i) => ({
  id: i + 1,
  crewName: `Crew Member ${i % 5 + 1}`,
  documentType: documentTypes[i % documentTypes.length],
  status: "Pending",
  uploadDate: `2025-09-${(i % 30) + 1}`,
  pdfUrl: samplePdf,
  name: `Crew Member ${i % 5 + 1}`,
  passportNumber: `A1234${i}`,
  expiryDate: `202${(i % 5) + 6}-12-31`,
  department: ["Deck", "Engine", "Catering", "Hotel", "Medical"][i % 5],
}));

const CrewDocuments: React.FC = () => {
  // State management
  const [expandedCrew, setExpandedCrew] = useState<string | null>(null);
  const [approvedDocs, setApprovedDocs] = useState<number[]>([]);
  const [rejectedDocs, setRejectedDocs] = useState<number[]>([]);
  const [searchTerm, setSearchTerm] = useState("");
  const [selectedDocId, setSelectedDocId] = useState<number | null>(null);
  const [selectedPdfUrl, setSelectedPdfUrl] = useState<string>(samplePdf);
  const [extractedData, setExtractedData] = useState<Partial<CrewDocument>>({});
  const [comment, setComment] = useState("");
  const [showInfo, setShowInfo] = useState(false);
  const [infoDocType, setInfoDocType] = useState<string | null>(null);
  const [showPreview, setShowPreview] = useState(false);

  // Calculate pending docs per crew
  const pendingDocsPerCrew = mockData.reduce<Record<string, CrewDocument[]>>((acc, doc) => {
    if (!approvedDocs.includes(doc.id) && !rejectedDocs.includes(doc.id)) {
      acc[doc.crewName] = acc[doc.crewName] || [];
      acc[doc.crewName].push(doc);
    }
    return acc;
  }, {});

  // Crew lists
  const crewList = Array.from(new Set(mockData.map((doc) => doc.crewName)));
  const approvedCrews = crewList.filter((crewName) => {
    const crewDocs = mockData.filter((doc) => doc.crewName === crewName);
    return crewDocs.length > 0 && crewDocs.every((doc) => approvedDocs.includes(doc.id));
  });
  const filteredPendingCrewList = Object.keys(pendingDocsPerCrew)
    .filter((name) => name.toLowerCase().includes(searchTerm.toLowerCase()));

  function handleApprove() {
    if (selectedDocId !== null) {
      setApprovedDocs((prev) => [...prev, selectedDocId]);
      setComment("");
    }
  }
  function handleReject() {
    if (selectedDocId !== null) {
      setRejectedDocs((prev) => [...prev, selectedDocId]);
      setComment("");
    }
  }

  return (
    <div className="animate-fade-in min-h-screen">
      {/* Header and View Filter */}
      <div className="mb-6 flex justify-between items-center">
        <div>
          <h1 className="text-2xl font-bold text-aviation-secondary">Crew Documents</h1>
          <p className="text-muted-foreground">Manage Crew Documents</p>
        </div>
      </div>
      {/* Cards Row */}
      <div className="flex flex-col md:flex-row gap-4 mb-4">
        <div className="bg-yellow-100 border-l-4 border-yellow-400 rounded-lg shadow p-4 flex-1">
          <h3 className="text-lg font-semibold text-yellow-700">Pending Documents</h3>
          <p className="text-2xl font-bold text-yellow-800">{filteredPendingCrewList.length}</p>
        </div>
        <div className="bg-green-100 border-l-4 border-green-500 rounded-lg shadow p-4 flex-1">
          <h3 className="text-lg font-semibold text-green-700">Approved Documents</h3>
          <p className="text-2xl font-bold text-green-800">{approvedCrews.length}</p>
        </div>
      </div>

      {/* Search Bar */}
      <div className="relative w-full px-2 mb-8">
    <div className="p-[3px] rounded-full bg-gradient-to-r from-yellow-400 via-red-500 via-green-400 to-blue-500 animate-glow">
    <input
      type="text"
      placeholder="Ask Anything with AI mode..."
      value={searchTerm}
      onChange={(e) => setSearchTerm(e.target.value)}
      className="w-full pr-32 pl-4 py-3 text-sm text-black bg-white rounded-full focus:outline-none"
    />
  </div>

  {searchTerm && (
    <button
      onClick={() => console.log("Generate clicked with:", searchTerm)}
      className="absolute right-3 top-1/2 -translate-y-1/2 px-4 py-1.5 
                 text-sm font-bold text-transparent bg-clip-text 
                 bg-gradient-to-r from-yellow-100 to-[#000099] 
                 flex items-center gap-1 rounded-full border-2 border-transparent 
                 transition"
    >
      <span className=" text-yellow-400">✨</span>
      Ask
    </button>
  )}
</div>

      {/* Document Table */}
      <div className="bg-white p-6 rounded-lg shadow mb-6 border" 
      style={{ borderColor: "#000099", borderWidth: "2px"}}>
        <table className="w-full table-auto rounded-md ">
          <thead className="bg-[#e6f0ff] text-[#000099]">
            <tr>
              <th className="px-4 py-2 text-left">Crew Name</th>
              <th className="px-4 py-2 text-left">Upload Date</th>
              <th className="px-4 py-2 text-left">Documents</th>
              <th className="px-4 py-2 text-left">Status</th>
            </tr>
          </thead>
          <tbody>
            {filteredPendingCrewList.map((crewName) => {
              const docs = pendingDocsPerCrew[crewName];
              const allApproved = !docs || docs.length === 0;
              if (!docs || docs.length === 0) return null;
              return (
                <React.Fragment key={crewName}>
                  <tr className="border-t">
                    <td className="px-4 py-2">{crewName}</td>
                    <td className="px-4 py-2">{docs[0]?.uploadDate || "-"}</td>
                    <td className="px-4 py-2">
                      <button
                        onClick={() => setExpandedCrew(expandedCrew === crewName ? null : crewName)}
                        className="text-[#000099] underline"
                      >
                        {docs.length} Document{docs.length !== 1 ? "s" : ""}
                      </button>
                    </td>
                    <td className="px-4 py-2">
                      {allApproved ? (
                        <div className="flex items-center gap-2 text-green-600 font-semibold">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            className="h-5 w-5 text-green-600"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            strokeWidth={2}
                          >
                            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                          Approved
                        </div>
                      ) : (
                        <span className="text-yellow-600 font-medium">Pending</span>
                      )}
                    </td>
                  </tr>
                  {expandedCrew === crewName && (
                    <tr>
                      <td colSpan={4} className="bg-gray-50 border-t border-b">
                        <div className="flex flex-wrap gap-4 my-4">
                          {docs.map((doc) => (
                            <div
                              key={doc.id}
                              className="cursor-pointer min-w-[180px] flex flex-col items-center justify-between p-3 rounded border shadow-sm bg-white"
                              onClick={() => {
                                setSelectedPdfUrl(doc.pdfUrl || samplePdf);
                                setExtractedData(doc);
                                setSelectedDocId(doc.id);
                                setShowPreview(true);
                              }}
                            >
                              {/* PDF Icon */}
                              <div className="text-red-600 mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                  className="h-10 w-10"
                                  fill="currentColor"
                                  viewBox="0 0 24 24">
                                  <path d="M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6zm7 1.5L18.5 9H13a1 1 0 0 1-1-1V3.5zM8 13h1v5H8v-5zm2.5 0h1.5a1.5 1.5 0 0 1 0 3H10.5v-3zm3.5 0h1v5h-1v-5z" />
                                </svg>
                              </div>
                              {/* Document Name */}
                              <span className="text-center font-medium text-sm mb-2">{doc.documentType}</span>
                            </div>
                          ))}
                        </div>
                      </td>
                    </tr>
                  )}
                </React.Fragment>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* Modal for document preview + approve/reject/comments/info */}
      {showPreview && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="relative bg-white rounded-lg shadow-lg w-[90%] max-w-6xl h-[80vh] flex overflow-hidden">
             {/*close buttton*/}
               <button
                onClick={() => setShowPreview(false)}
                className="absolute top-1 right-1 text-gray-600 hover:text-black"
                title="Close"
              >
                <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            {/* PDF on left */}
            <div className="w-1/2 bg-gray-100 p-4 flex items-center justify-center">
              <iframe
                src={selectedPdfUrl}
                title="PDF Preview"
                className="w-full h-full border rounded"
                style={{ minHeight: "400px" }}
              />
            </div>
            
            {/* Extracted box on right */}
            <div className="w-1/2 p-6 flex flex-col">


              <div className="border rounded bg-gray-50 p-4 mb-6 relative">
                <div className="flex items-start justify-between">
                  <div>
                    <div className="font-bold mb-2">Extracted Data</div>
                    <div className="mb-1">Type: {extractedData.documentType}</div>
                    <div className="mb-1">Name: {extractedData.name}</div>
                    <div className="mb-1">Passport No.: {extractedData.passportNumber || "-"}</div>
                    <div className="mb-1">Expiry Date: {extractedData.expiryDate || "-"}</div>
                    <div className="mb-1">Department: {extractedData.department || "-"}</div>
                  </div>
                  <button
                    className="ml-2 text-blue-500 hover:text-blue-700"
                    onClick={() => {
                      setInfoDocType(extractedData.documentType || "");
                      setShowInfo(true);
                    }}
                    title="Show Approval Instructions"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg"
                      className="h-6 w-6" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="2" fill="#FFF" />
                      <text x="9.5" y="16" fill="blue" fontSize="9" fontFamily="Arial">i</text>
                    </svg>
                  </button>
                </div>
              </div>
              {/* Comment/Buttons */}
              <div className="mb-6">
                <label className="block text-sm font-medium mb-1">Comment</label>
                <textarea
                  value={comment}
                  onChange={(e) => setComment(e.target.value)}
                  className="w-full border rounded p-2 h-24 resize-none"
                  placeholder="Add your comment here..."
                />
              </div>
              <div className="flex justify-end space-x-4">
                <button
                  onClick={() => {
                    handleApprove();
                    setShowPreview(false);
                  }}
                  className="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700"
                >
                  Approve
                </button>
                <button
                  onClick={() => {
                    handleReject();
                    setShowPreview(false);
                  }}
                  className="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">
                  Reject
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Info box modal for approval instructions */}
      {showInfo && infoDocType && (
        <div className="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg p-6 w-[90%] max-w-md shadow-lg">
            <h3 className="text-xl font-semibold text-[#000099] mb-2">
              Approval Instructions
            </h3>
            <p className="text-gray-700 mb-4">
              {approvalConditions[infoDocType] || "No specific instructions for this document."}
            </p>
            <div className="flex justify-end">
              <button
                onClick={() => setShowInfo(false)}
                className="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400"
              >
                Close
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default CrewDocuments;
