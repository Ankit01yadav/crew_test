import React, { useState } from "react";

const approvalConditions = {
  "LATEST PASSPORT": "Ensure both front and back are uploaded in PDF format and passport is valid for at least 6 months.",
  "CREW ID CARD": "Front and back must be clearly visible in PDF format. Must match crew details.",
  "TRANSFER LETTER": "Only applicable if crew has changed base or department. Must be signed by HR.",
  "INITIAL CREW CONTRACT": "Must be signed and dated. Verify joining date and role.",
  "RENEWAL CREW CONTRACT": "Check for updated terms and renewal period. Must be signed.",
  "PROMOTION LETTER": "Applicable only if crew has been promoted. Must be signed by authorized personnel.",
  "PHOTOGRAPH PASSPORT SIZE": "Should be clear with white or blue background. No shadows or filters.",
  "EDUCATION CERTIFICATE": "Verify certificates from 10th to Graduation. Must be legible and authentic.",
  "AAHAR CARD": "Ensure full name and address are visible. Must be in PDF format.",
  "PAN CARD": "Verify PAN number and name. Must be clear and match crew records.",
};

const documentTypes = Object.keys(approvalConditions);
const samplePdf = "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf";

type DocumentStatus = "Pending" | "Approved" | "Rejected";
interface CrewDocument {
  id: number;
  crewName: string;
  documentType: string;
  status: DocumentStatus;
  uploadDate: string;
  pdfUrl?: string;
  name?: string;
  passportNumber?: string;
  expiryDate?: string;
  department?: string;
}

const mockData: CrewDocument[] = Array.from({ length: 20 }, (_, i) => ({
  id: i + 1,
  crewName: `Crew Member ${i % 5 + 1}`,
  documentType: documentTypes[i % documentTypes.length],
  status: "Pending",
  uploadDate: `2025-09-${(i % 30) + 1}`,
  pdfUrl: samplePdf,
  name: `Crew Member ${i % 5 + 1}`,
  passportNumber: `A1234${i}`,
  expiryDate: `202${(i % 5) + 6}-12-31`,
  department: ["Deck", "Engine", "Catering", "Hotel", "Medical"][i % 5],
}));

const statusMeta = {
  Pending: {
    icon: (
      <svg className="w-5 h-5 text-yellow-500 inline" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="2" fill="#facc15" />
        <text x="9" y="17" fill="#fff" fontSize="8" fontFamily="Arial">?</text>
      </svg>
    ),
    label: "Pending",
    color: "text-yellow-600 bg-yellow-50",
  },
  Approved: {
    icon: (
      <svg className="w-5 h-5 text-green-500 inline" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="2" fill="#22c55e" />
        <polyline points="9 12 12 15 16 10" fill="none" stroke="#fff" strokeWidth="2"/>
      </svg>
    ),
    label: "Approved",
    color: "text-green-600 bg-green-50",
  },
  Rejected: {
    icon: (
      <svg className="w-5 h-5 text-red-500 inline" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="2" fill="#ef4444"/>
        <line x1="9" y1="9" x2="15" y2="15" stroke="#fff" strokeWidth="2"/>
        <line x1="15" y1="9" x2="9" y2="15" stroke="#fff" strokeWidth="2"/>
      </svg>
    ),
    label: "Rejected",
    color: "text-red-600 bg-red-50",
  },
};

const CrewDocuments: React.FC = () => {
  const [docs, setDocs] = useState<CrewDocument[]>(mockData);
  const [expanded, setExpanded] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [tooltip, setTooltip] = useState<{type: string, anchor: number} | null>(null);
  const [previewDoc, setPreviewDoc] = useState<CrewDocument | null>(null);

  // Search and filter logic
  const crewGroups: Record<string, CrewDocument[]> = docs.reduce((acc, doc) => {
    if (!acc[doc.crewName]) acc[doc.crewName] = [];
    acc[doc.crewName].push(doc);
    return acc;
  }, {} as Record<string, CrewDocument[]>);

  const crewNames = Object.keys(crewGroups)
    .filter(name => name.toLowerCase().includes(search.toLowerCase()));

  // Stats
  const pendingDocs = docs.filter(doc => doc.status === "Pending").length;
  const approvedCrews = Object.keys(crewGroups)
    .filter(name => crewGroups[name].every(doc => doc.status === "Approved")).length;

  // Approve/Reject immediately in place
  function handleDecision(docId: number, status: "Approved" | "Rejected") {
    setDocs(prev =>
      prev.map(d =>
        d.id === docId ? { ...d, status } : d
      )
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-tr from-blue-50 to-white p-4 md:p-8">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:justify-between items-start md:items-center mb-6 gap-2">
        <div>
          <h1 className="text-3xl font-extrabold text-[#000099]">Crew Documents</h1>
          <p className="text-gray-500">Manage and review all crew documents</p>
        </div>
        <div className="flex gap-2 mt-4 md:mt-0">
          {/* Pending */}
          <div className="flex items-center bg-yellow-50 px-4 py-2 rounded shadow gap-2 border border-yellow-200 min-w-[110px]">
            <span className="text-yellow-400">{statusMeta.Pending.icon}</span>
            <span className="font-bold text-yellow-700">{pendingDocs}</span>
            <span className="text-xs text-yellow-600">Pending</span>
          </div>
          {/* Approved */}
          <div className="flex items-center bg-green-50 px-4 py-2 rounded shadow gap-2 border border-green-200 min-w-[110px]">
            <span className="text-green-500">{statusMeta.Approved.icon}</span>
            <span className="font-bold text-green-700">{approvedCrews}</span>
            <span className="text-xs text-green-600">Approved Crew</span>
          </div>
        </div>
      </div>

      {/* Search */}
      <div className="w-full max-w-xl mx-auto mb-6">
        <input value={search}
          onChange={e => setSearch(e.target.value)}
          className="w-full p-3 rounded-full border focus:ring-2 focus:ring-blue-300 bg-white shadow-sm text-sm transition"
          placeholder="Search crew by name..."
        />
      </div>

      {/* Content */}
      <div className="space-y-8">
        {crewNames.length === 0 && (
          <div className="text-center py-12 text-gray-400">
            No crew found. Try a different search.
          </div>
        )}
        {crewNames.map((crew) => (
          <div
            key={crew}
            className="bg-white rounded-xl shadow border p-4 transition border-blue-100"
          >
            {/* Crew header with expand/collapse */}
            <div
              className="flex items-center cursor-pointer group"
              onClick={() => setExpanded(expanded === crew ? null : crew)}
              tabIndex={0}
              aria-label={`Expand or collapse document list for ${crew}`}
              role="button"
            >
              <span className="mr-3 flex items-center">
                <svg
                  className={`h-5 w-5 transition-transform duration-200 mr-1 text-blue-400 group-hover:scale-110 ${expanded === crew ? "rotate-90" : "rotate-0"}`}
                  viewBox="0 0 20 20" fill="currentColor"
                >
                  <path fillRule="evenodd" d="M6 8l4 4 4-4" clipRule="evenodd" />
                </svg>
                <span className="text-lg font-semibold text-blue-900">{crew}</span>
              </span>
              <span className="text-gray-400 text-xs ml-auto mr-3">{crewGroups[crew].length} Docs</span>
              {/* Show All Approved? */}
              {crewGroups[crew].every(doc => doc.status === "Approved") && (
                <span className="ml-2">{statusMeta.Approved.icon} <span className="text-green-700 font-semibold">All Approved</span></span>
              )}
            </div>
            {/* Documents grid */}
            <div
              className={`mt-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 transition-all overflow-hidden ${expanded === crew ? 'max-h-[2000px]' : 'max-h-0'} duration-300`}
              style={{ display: expanded === crew ? "grid" : "none" }}
            >
              {crewGroups[crew].map((doc, idx) => (
                <div
                  key={doc.id}
                  className={`p-4 rounded-lg border shadow-sm bg-[#f7fafc] group hover:shadow-lg transition relative`}
                >
                  <div className="w-full flex items-start justify-between">
                    <div className="flex-1">
                      <div className="font-semibold text-blue-800 mb-0.5 flex items-center gap-1">
                        <span className="truncate" title={doc.documentType}>{doc.documentType}</span>
                        <button
                          className="ml-1 text-blue-400 hover:text-blue-700 focus:outline-none"
                          onClick={e => {
                            e.stopPropagation(); setTooltip({ type: doc.documentType, anchor: doc.id });
                          }}
                          title="Show Approval Info"
                          tabIndex={0}
                        >
                          <svg className="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <circle cx="10" cy="10" r="10" fill="#dbeafe" />
                            <text x="6.5" y="15" fill="#2563eb" fontSize="11" fontFamily="Arial">i</text>
                          </svg>
                        </button>
                        {/* Tooltip */}
                        {tooltip?.anchor === doc.id && tooltip?.type === doc.documentType && (
                          <div
                            className="absolute z-20 bg-white text-xs rounded px-3 py-2 border shadow max-w-xs top-9 left-0"
                            onMouseLeave={() => setTooltip(null)}
                            tabIndex={0}
                          >
                            <strong>Instructions:</strong>
                            <br />
                            {approvalConditions[doc.documentType] || "No specific instructions."}
                          </div>
                        )}
                      </div>
                      <div className="text-xs text-gray-500 mb-2">{doc.uploadDate}</div>
                      <div className="text-xs text-gray-700">Dept: {doc.department || "-"}</div>
                    </div>
                    <div className="flex-shrink-0 ml-2">
                      <span className={`rounded px-2 py-1 text-xs font-semibold ${statusMeta[doc.status].color} flex gap-1 items-center`}>{statusMeta[doc.status].icon} {statusMeta[doc.status].label}</span>
                    </div>
                  </div>
                  {/* Quick data and Actions Block */}
                  <div className="mt-2 flex items-end justify-between gap-2 flex-wrap">
                    <div>
                      <div className="text-xs text-gray-700">Name: <span className="font-medium">{doc.name}</span></div>
                      <div className="text-xs text-gray-700">Passport: {doc.passportNumber || "-"}</div>
                      {doc.expiryDate && <div className="text-xs text-gray-500">Expires: {doc.expiryDate}</div>}
                    </div>
                    <div className="space-x-1">
                      <button
                        className="inline-flex items-center px-3 py-1 rounded bg-gradient-to-r from-blue-100 to-blue-300 text-blue-800 text-xs font-bold shadow hover:bg-blue-200 transition"
                        title="Preview PDF"
                        onClick={() => setPreviewDoc(doc)}
                      >
                        <svg className="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                          <rect width="14" height="18" x="5" y="3" rx="2" fill="#d1d5db" />
                          <path d="M8 8h8M8 12h8M8 16h4" stroke="#2563eb" strokeWidth="2" />
                        </svg>
                        View
                      </button>
                      {doc.status === "Pending" && (
                        <>
                          <button
                            className="inline-flex items-center px-2 py-1 rounded bg-green-100 text-green-700 font-bold text-xs hover:bg-green-200"
                            title="Approve"
                            onClick={() => handleDecision(doc.id, "Approved")}
                          >
                            <svg className="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill="#22c55e" d="M6 10l4 4 6-8"/></svg>Approve
                          </button>
                          <button
                            className="inline-flex items-center px-2 py-1 rounded bg-red-100 text-red-700 font-bold text-xs hover:bg-red-200 ml-1"
                            title="Reject"
                            onClick={() => handleDecision(doc.id, "Rejected")}
                          >
                            <svg className="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                              <circle cx="10" cy="10" r="10" fill="#ef4444"/>
                              <line x1="7" y1="7" x2="13" y2="13" stroke="#fff" strokeWidth="2"/>
                              <line x1="13" y1="7" x2="7" y2="13" stroke="#fff" strokeWidth="2"/>
                            </svg>Reject
                          </button>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* PDF Preview Modal */}
      {previewDoc && (
        <div className="fixed inset-0 z-50 bg-black bg-opacity-40 flex items-center justify-center px-2 py-6">
          <div className="bg-white rounded-lg max-w-2xl w-full p-6 shadow-lg relative flex flex-col md:flex-row gap-4">
            {/* Close */}
            <button onClick={() => setPreviewDoc(null)} className="absolute top-2 right-2 text-gray-400 hover:text-red-600">
              <svg className="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth={2}>
                <line x1="6" y1="18" x2="18" y2="6"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
            {/* PDF */}
            <div className="flex-1 border rounded bg-gray-100 flex justify-center items-center min-h-[300px]">
              <iframe src={previewDoc.pdfUrl} title="PDF Preview" className="w-full h-80 rounded border shadow" />
            </div>
            {/* Details */}
            <div className="flex-1 min-w-[200px]">
              <div className="font-semibold text-blue-900 mb-1">{previewDoc.documentType}</div>
              <div className="mb-2 text-xs text-gray-500">{previewDoc.uploadDate}</div>
              <div className="mb-2 text-xs">Name: <span className="font-medium">{previewDoc.name}</span></div>
              <div className="mb-2 text-xs">Passport: {previewDoc.passportNumber || "-"}</div>
              <div className="mb-2 text-xs">Department: {previewDoc.department || "-"}</div>
              <div className="mb-2 text-xs">Expiry: {previewDoc.expiryDate || "-"}</div>
              <div className={`mt-2 text-xs font-bold ${statusMeta[previewDoc.status].color}`}>Status: {statusMeta[previewDoc.status].label}</div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default CrewDocuments;
